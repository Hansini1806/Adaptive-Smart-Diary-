# Copy this file to backend/.env and fill in the same project URL and
# publishable key used by the Vite app. Never use a service-role key here.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional. Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Defaults to ../ml/artifacts relative to the backend folder.
# EMOTION_MODEL_DIR=C:\path\to\ai-smart-diary\ml\artifacts
